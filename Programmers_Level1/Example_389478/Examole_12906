/// 문제 : 같은 숫자는 싫어
/// URL : https://school.programmers.co.kr/learn/courses/30/lessons/12906
/// </summary>

function solution(arr)
{ 
    var answer = [];
    answer.push(arr[0]);
    
    for(var i = 1; i < arr.length; i++)
    {
        var peek = answer[answer.length - 1];
        
        if(peek == arr[i]) continue;
        
        answer.push(arr[i]);
    }
    
    return answer;
}